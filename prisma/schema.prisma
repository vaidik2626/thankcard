generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (app runtime)
  directUrl = env("DIRECT_URL") // direct connection (schema changes)
}

/// A seller brand whose details pre-fill new cards.
model BrandProfile {
  id             String   @id @default(cuid())
  name           String
  businessName   String?
  logoDataUrl    String?  @db.Text
  whatsappNumber String?
  feedbackUrl    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  cards          Card[]
}

/// Reusable design: texts, dimensions, fonts, sizes and spacing (CardDesign JSON).
model Template {
  id          String   @id @default(cuid())
  name        String
  description String?
  design      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cards       Card[]
}

model Card {
  id             String        @id @default(cuid())
  title          String
  brandName      String
  businessName   String?
  logoDataUrl    String?       @db.Text
  productName    String
  reviewUrl      String        @db.Text
  feedbackUrl    String        @db.Text
  whatsappNumber String?
  customMessage  String?       @db.Text
  /// CardDesign JSON snapshot so a card renders the same even if its template changes.
  design         Json
  brandProfile   BrandProfile? @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)
  brandProfileId String?
  template       Template?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateId     String?
  bulkJob        BulkJob?      @relation(fields: [bulkJobId], references: [id], onDelete: SetNull)
  bulkJobId      String?
  exportCount    Int           @default(0)
  lastExportedAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([brandProfileId])
  @@index([updatedAt])
}

enum BulkJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// CSV bulk generation run. Rows become Card records linked to the job.
model BulkJob {
  id          String        @id @default(cuid())
  fileName    String
  status      BulkJobStatus @default(PENDING)
  totalRows   Int
  createdRows Int           @default(0)
  errors      Json?
  templateId  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  cards       Card[]
}
